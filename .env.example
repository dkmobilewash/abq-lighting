# Where /api/quote forwards quote-form submissions (JSON POST).
# Works with Zapier/Make/n8n webhooks, a CRM inbound webhook, or an email relay.
QUOTE_WEBHOOK_URL=

# Optional: public site URL override (defaults to business.domain in src/data/business.ts)
NEXT_PUBLIC_SITE_URL=

# Search Console / Bing Webmaster Tools HTML-tag verification codes (content value only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
